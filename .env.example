# Credenciais locais. Use caracteres seguros para URLs na senha.
POSTGRES_DB=uber
POSTGRES_USER=uber
POSTGRES_PASSWORD=uber_local
POSTGRES_PORT=5432
ADMINER_PORT=8080

# Conexão para executar o Expo fora do Docker.
# O Compose substitui DATABASE_URL pelo endereço interno do serviço db.
DATABASE_DRIVER=postgres
# Para usar Neon no contêiner: DATABASE_DRIVER=neon e DOCKER_DATABASE_URL com a URL do Neon.
DOCKER_DATABASE_URL=
DATABASE_URL=postgresql://uber:uber_local@localhost:5432/uber

# Por padrão, os serviços ficam disponíveis apenas no computador local.
# Para celular na mesma rede: APP_BIND_HOST=0.0.0.0 e IP local nos dois campos abaixo.
APP_BIND_HOST=127.0.0.1
# No celular, substitua localhost pelo IP do computador nos dois campos.
EXPO_PUBLIC_SERVER_URL=http://localhost:8081
REACT_NATIVE_PACKAGER_HOSTNAME=localhost

# Serviços externos: preencha com suas próprias chaves.
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=
# Opcional na web: requer Maps Embed API ativada. Vazio usa OpenStreetMap.
EXPO_PUBLIC_MAPS_EMBED_API_KEY=
EXPO_PUBLIC_PLACES_API_KEY=
EXPO_PUBLIC_DIRECTIONS_API_KEY=
EXPO_PUBLIC_GEOAPIFY_API_KEY=
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
